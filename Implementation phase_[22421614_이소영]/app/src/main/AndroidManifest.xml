<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BareunJigap">

        <!-- 로그인 -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 회원가입 -->
        <activity
            android:name=".ui.login.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 메인 (BottomNav 포함) -->
        <activity
            android:name=".ui.dashboard.MainActivity"
            android:exported="false" />

        <!-- 거래 추가/편집 -->
        <activity
            android:name=".ui.transaction.TransactionEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 더치페이 -->
        <activity
            android:name=".ui.dutchpay.DutchPayActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 예산 설정 -->
        <activity
            android:name=".ui.budget.BudgetSettingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 고정일정 설정 -->
        <activity
            android:name=".ui.budget.FixedScheduleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- WorkManager 자동초기화 비활성화 후 수동 등록 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.impl.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 부팅 시 알림 재등록 -->
        <receiver
            android:name=".util.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
